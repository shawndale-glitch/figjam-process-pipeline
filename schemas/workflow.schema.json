{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shawndale-glitch/figjam-process-pipeline/schemas/workflow.schema.json",
  "title": "Process workflow (exported from FigJam)",
  "description": "Contract for workflows/<area>/<process_id>/workflow.yaml. Generated by tooling/workflow_export.py; never edited by hand. Graph rules (reachability, gateway exits, lanes) are enforced by the linter. See governance/workflow-rules.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "process", "lanes", "nodes", "flows"],
  "$defs": {
    "figmaId": { "type": "string", "pattern": "^\\d+:\\d+$" },
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "processId": { "type": "string", "pattern": "^[A-Z0-9]{2,6}-\\d{2,3}(\\.\\d+)?$", "description": "[AREA]-[NN] or [AREA]-[NNN]; sub-processes add .n (e.g. P2P-03.1)" }
  },
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "area", "owner", "version", "status", "updated", "state", "source", "content_hash"],
      "properties": {
        "id": { "$ref": "#/$defs/processId" },
        "name": { "type": "string", "minLength": 3 },
        "area": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Folder under workflows/ and docs/processes/. Controlled list TBC." },
        "owner": { "type": "string", "description": "Role accountable for the process (from header 'Responsable')." },
        "version": { "$ref": "#/$defs/semver" },
        "declared_version": { "type": "string", "description": "Raw value of the FigJam header 'Versión', kept for the header check." },
        "status": { "enum": ["draft", "in-review", "validated", "deprecated"] },
        "updated": { "$ref": "#/$defs/date" },
        "state": { "enum": ["as-is", "to-be"] },
        "validated_by": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "date"],
          "properties": { "role": { "type": "string" }, "date": { "$ref": "#/$defs/date" } }
        },
        "supersedes": { "type": "array", "items": { "type": "string" } },
        "superseded_by": { "type": "string" },
        "related": { "type": "array", "items": { "type": "string" }, "description": "Topic IDs in the docs corpus (e.g. concept.invoice.approval)." },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["figma_file_key", "figma_page_or_section", "exported_at"],
          "properties": {
            "figma_file_key": { "type": "string" },
            "figma_page_or_section": { "$ref": "#/$defs/figmaId" },
            "figma_version_id": { "type": "string" },
            "exported_at": { "type": "string", "format": "date-time" },
            "exported_by": { "type": "string" },
            "library_version": { "type": "string", "description": "Version of the Process Design Standards library used." }
          }
        },
        "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "validated" } } }, "then": { "required": ["validated_by"] } },
        { "if": { "properties": { "status": { "const": "deprecated" } } }, "then": { "required": ["superseded_by"] } }
      ]
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role"],
        "properties": { "id": { "$ref": "#/$defs/figmaId" }, "role": { "type": "string", "minLength": 1 } }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/figmaId" },
          "alias": { "type": "string", "description": "Readable step ID, e.g. P2P-03.A03" },
          "type": {
            "enum": ["event.start", "event.intermediate", "event.end", "link", "task", "subprocess",
                     "gateway.xor", "gateway.and", "system", "document", "datastore", "rule", "note"]
          },
          "lane": { "type": ["string", "null"] },
          "label": { "type": "string" },
          "ref": { "type": "string", "description": "subprocess/link target process ID" },
          "change": { "enum": ["changed", "pain_point", "removed"] }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "type"],
        "properties": {
          "id": { "$ref": "#/$defs/figmaId" },
          "from": { "$ref": "#/$defs/figmaId" },
          "to": { "$ref": "#/$defs/figmaId" },
          "type": { "enum": ["sequence", "message"] },
          "condition": { "type": "string" }
        }
      }
    },
    "associations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to"],
        "properties": {
          "id": { "$ref": "#/$defs/figmaId" },
          "from": { "$ref": "#/$defs/figmaId" },
          "to": { "$ref": "#/$defs/figmaId" },
          "type": { "const": "association" }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": { "id": { "$ref": "#/$defs/figmaId" }, "author": { "type": "string" }, "text": { "type": "string" } }
      }
    }
  }
}
